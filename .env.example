# Core application
DATABASE_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Required for credential encryption at rest (AES-256-GCM). Generate with:
# openssl rand -base64 32
# Set this same 32-byte key in every runtime environment that reads the same database.
# Keep it in a secret manager; changing it requires re-encrypting stored credentials.
CREDENTIALS_ENCRYPTION_KEY=

# OAuth providers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Polar billing
POLAR_ACCESS_TOKEN=
POLAR_SUCCESS_URL=http://localhost:3000/workflows

# Inngest (optional for local dev server; required for hosted execution)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Sentry (optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Neon Functions (set to the invocation URL returned by `neon functions get hello`)
NEON_HELLO_FUNCTION_URL=
TASKORBIT_FUNCTION_HEALTH_TOKEN=

# Meta WhatsApp Cloud API version used by WhatsApp workflow nodes.
# Version availability follows Meta's release lifecycle; verify before upgrading.
WHATSAPP_GRAPH_API_VERSION=v26.0
